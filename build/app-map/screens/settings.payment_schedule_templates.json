  "cards": [
    {
      "title": "Payment plans",
      "intro": [
        "Manage payment settings. The most common payment method is one-off payment. However, you can also use scheduled payments. At the programme level, you then choose from a menu of payment options that will be available for classes."
      ],
      "sections": [],
      "fields": [],
      "buttons": []
    },
    {
      "title": "Prepaid Periodic Payment, Monthly › Payment plans",
      "intro": [
        "Example dates for a payment scheduled on day 1 of the month, based on your current payment settings. Change notification & due-date settings",
        "Indicate who will be able to use this template"
      ],
      "sections": [
        "Visibility"
      ],
      "fields": [
        {
          "label": "Template name",
          "type": "text",
          "help": ""
        },
        {
          "label": "Frequency of payment:",
          "type": "radio_group",
          "help": "",
          "options": [
            "Monthly",
            "Quarterly",
            "Half-yearly",
            "Yearly",
            "After N sessions",
            "By block",
            "Fixed number of scheduled payments"
          ]
        },
        {
          "label": "Day of the month when the payment is due",
          "type": "number",
          "help": "If you enter zero, this setting will not be used and the payments will be distributed evenly over time. If you enter a day, payments will be due on the next anniversary date."
        },
        {
          "label": "Rounding method",
          "type": "radio_group",
          "help": "",
          "options": [
            "None — 45.76 -> 45.76",
            "Up — 45.76 -> 46.00",
            "Down — 45.76 -> 45.00",
            "Half up — 45.76 -> 46.00",
            "Half down — 45.76 -> 45.50",
            "Baťa’s price (More) — 45.76 -> 45.99"
          ]
        },
        {
          "label": "Do not create scheduled payments if there are no sessions in the selected period",
          "type": "toggle",
          "help": "Scheduled payments will not be created for periods in which there are no sessions. For example, if you have an annual programme with a break in the summer months and the selected period is a month, no scheduled payment will be created for the summer-break months."
        },
        {
          "label": "Discount:",
          "type": "radio_group",
          "help": "",
          "options": [
            "None",
            "Absolute",
            "In percentage"
          ]
        },
        {
          "label": "Clients",
          "type": "checkbox",
          "help": "Clients will be able to select this template when enroling"
        },
        {
          "label": "Instructors",
          "type": "checkbox",
          "help": "Instructors will be able to apply this template in the booking details"
        }
      ],
      "buttons": [],
      "route": "settings/payment_schedule_templates/112"
    },
